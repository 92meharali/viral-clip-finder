# AI Provider
AI_PROVIDER=cursor
AI_ANALYSIS_RESPONSE_PATH=analysis_response.json
AI_METADATA_RESPONSE_PATH=metadata_response.json

# OpenAI (only required when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7

# Clip settings
MAX_CLIPS=10
MIN_CLIP_DURATION_SECONDS=20
MAX_CLIP_DURATION_SECONDS=90

# Output
OUTPUT_DIR=output
VERTICAL_WIDTH=1080
VERTICAL_HEIGHT=1920
VERTICAL_BLUR_STRENGTH=20

# Subtitles
SUBTITLE_FONT=Arial
SUBTITLE_SIZE=24
SUBTITLE_OUTLINE=2
SUBTITLE_COLOR=white
SUBTITLE_POSITION=bottom

# Quality checks
MIN_VIRAL_SCORE=5.0
MAX_SILENCE_RATIO=0.6

# Intelligent reframing (Phase X)
FACE_DETECTOR=mediapipe
FACE_DETECTION_MIN_CONFIDENCE=0.5
FACE_EXTRACTION_FPS=2.0
MINIMUM_FACE_SIZE=40
FACE_TRACKER=iou
TRACKING_IOU_THRESHOLD=0.3
TRACKING_MAX_CENTER_DISTANCE=250
TRACKING_MAX_AGE=5
SCENE_DETECTOR=ffmpeg
SCENE_DETECTION_THRESHOLD=0.35
SCENE_MIN_GAP_SECONDS=0.5
SCENE_EXTRACTION_FPS=4.0
SPEAKER_ESTIMATOR=fusion
SPEAKER_WEIGHT_TRANSCRIPT=0.25
SPEAKER_WEIGHT_MOUTH=0.35
SPEAKER_WEIGHT_ORIENTATION=0.20
SPEAKER_WEIGHT_AUDIO=0.20
SPEAKER_MIN_CONFIDENCE=0.4
SPEAKER_MIN_SEGMENT_SECONDS=0.3
SPEAKER_AUDIO_WINDOW_SECONDS=0.25
IMPORTANCE_SCORER=fusion
IMPORTANCE_WEIGHT_SPEAKING=0.30
IMPORTANCE_WEIGHT_EXPRESSION=0.15
IMPORTANCE_WEIGHT_DETECTION=0.10
IMPORTANCE_WEIGHT_CENTER=0.10
IMPORTANCE_WEIGHT_PRESENCE=0.15
IMPORTANCE_WEIGHT_RECENT_SPEAKER=0.10
IMPORTANCE_WEIGHT_REACTION=0.10
IMPORTANCE_RECENT_SPEAKER_DECAY_SECONDS=3.0
COMPOSITION_PLANNER=heuristic
COMPOSITION_MIN_PADDING=40
COMPOSITION_FOREHEAD_PADDING_RATIO=0.35
COMPOSITION_RULE_OF_THIRDS_OFFSET=0.08
COMPOSITION_CONVERSATION_IMPORTANCE_GAP=0.15
COMPOSITION_SECONDARY_IMPORTANCE_MIN=0.45
COMPOSITION_GROUP_FACE_THRESHOLD=3
COMPOSITION_VOTE_REVEAL_FACE_THRESHOLD=4
COMPOSITION_GROUP_IMPORTANCE_MIN=0.35
COMPOSITION_RAPID_DISCUSSION_SECONDS=2.0
COMPOSITION_RAPID_SPEAKER_CHANGES=3
COMPOSITION_ZOOM_SINGLE_SPEAKER=1.0
COMPOSITION_ZOOM_CONVERSATION=1.25
COMPOSITION_ZOOM_GROUP_REACTION=1.45
COMPOSITION_ZOOM_VOTE_REVEAL=1.7
CAMERA_PLANNER=pursuit
CAMERA_MAX_PAN_SPEED=450
CAMERA_MAX_ZOOM_SPEED=500
CAMERA_SMOOTHING=0.35
CAMERA_SCENE_RESET=true
CAMERA_SCENE_BOUNDARY_TOLERANCE=0.15
TEMPORAL_SMOOTHER=ema
SMOOTHING_STRENGTH=0.25
SMOOTHING_MAX_JERK=800
SMOOTHING_ZOOM_OSCILLATION_DAMPING=0.5
SMOOTHING_SCENE_BOUNDARY_TOLERANCE=0.15
CROP_GENERATOR=safe
CROP_FACE_SAFETY_PADDING=20
CROP_MIN_FACE_VISIBILITY=0.95
REFRAME_RENDERER=ffmpeg
REFRAME_RENDER_FPS=30
REFRAME_SEGMENT_MERGE_THRESHOLD=5.0
REFRAME_RENDER_PRESET=fast
REFRAME_RENDER_CRF=23
REFRAME_BLUR_BACKGROUND=false
REFRAME_PAN_ONLY=true
REFRAME_PAN_SMOOTHING_STRENGTH=0.10
REFRAME_PAN_SPEAKER_SWITCH_SMOOTHING=0.22
REFRAME_PAN_DEADBAND_PIXELS=4
VERTICAL_CROP_MODE=reframe
BATCH_STRUCTURED_OUTPUT=false
CANDIDATE_WINDOW_MIN_DURATION=20
CANDIDATE_WINDOW_MAX_DURATION=90
CANDIDATE_WINDOW_MERGE_GAP=3.0

# Logging
LOG_LEVEL=INFO

# YouTube ingestion
YOUTUBE_PREFERRED_LANGUAGES=en,en-US,en-GB
YOUTUBE_SUBTITLE_FORMAT_PRIORITY=vtt,srv3,json3,ttml
