# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7

# Clip settings
MAX_CLIPS=10
MIN_CLIP_DURATION_SECONDS=20
